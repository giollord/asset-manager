<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/AssetManager.Shared/lib/roboto/roboto.css"]" />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["_content/AssetManager.Shared/app.css"]" />
    <link rel="stylesheet" href="@Assets["AssetManager.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="_content/AssetManager.Shared/logo-mark.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="_content/AssetManager.Shared/favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <div id="blazor-error-ui" data-nosnippet>
        <div class="mud-alert mud-alert-filled-error mud-elevation-0 pa-3">
            An unhandled error has occurred.
            <a href="." class="reload">Reload</a>
            <span class="dismiss">🗙</span>
        </div>
    </div>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
</body>

</html>
