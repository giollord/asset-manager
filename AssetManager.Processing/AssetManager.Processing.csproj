<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AssetManager.Core\AssetManager.Core.csproj" />
    <ProjectReference Include="..\AssetManager.Data\AssetManager.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AssimpNetter" Version="6.0.5" />
    <PackageReference Include="FFMpegCore" Version="6.0.0" />
    <PackageReference Include="Magick.NET-Q8-x64" Version="15.1.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="SharpCompress" Version="0.50.9" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.15" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Bundled FFmpeg (LGPL, shared build) used for audio/video metadata and previews (design D6).
    Pinned build from BtbN/FFmpeg-Builds; downloaded once at build time, verified by SHA-256 and kept
    (git-ignored) in native/ffmpeg. Copied to the output as ffmpeg/*.
  -->
  <PropertyGroup>
    <FfmpegUrl>https://github.com/BtbN/FFmpeg-Builds/releases/download/autobuild-2026-11-12-15-40/ffmpeg-n8.1.3-35-gf1acb0a266-win64-lgpl-shared-8.1.zip</FfmpegUrl>
    <FfmpegSha256>BB6EEDD1978549C84E8DFF7B72C885DF090DB6A6EE1DE44E76C8855BABEA495C</FfmpegSha256>
    <FfmpegDir>$(MSBuildThisFileDirectory)native/ffmpeg/</FfmpegDir>
    <FfmpegDownloadDir>$(MSBuildThisFileDirectory)obj/ffmpeg-download/</FfmpegDownloadDir>
  </PropertyGroup>

  <Target Name="FetchFfmpeg" Condition="!Exists('$(FfmpegDir)ffprobe.exe')">
    <DownloadFile SourceUrl="$(FfmpegUrl)" DestinationFolder="$(FfmpegDownloadDir)" DestinationFileName="ffmpeg.zip" Retries="2" />
    <VerifyFileHash File="$(FfmpegDownloadDir)ffmpeg.zip" Hash="$(FfmpegSha256)" Algorithm="SHA256" />
    <Unzip SourceFiles="$(FfmpegDownloadDir)ffmpeg.zip" DestinationFolder="$(FfmpegDownloadDir)x" OverwriteReadOnlyFiles="true" />
    <ItemGroup>
      <_FfmpegFiles Include="$(FfmpegDownloadDir)x/*/bin/*.dll;$(FfmpegDownloadDir)x/*/bin/ffmpeg.exe;$(FfmpegDownloadDir)x/*/bin/ffprobe.exe" />
      <_FfmpegLicense Include="$(FfmpegDownloadDir)x/*/LICENSE.txt" />
    </ItemGroup>
    <Copy SourceFiles="@(_FfmpegFiles)" DestinationFolder="$(FfmpegDir)" />
    <Copy SourceFiles="@(_FfmpegLicense)" DestinationFiles="$(FfmpegDir)FFMPEG.LICENSE.txt" />
    <RemoveDir Directories="$(FfmpegDownloadDir)" />
  </Target>

  <Target Name="IncludeFfmpeg" BeforeTargets="AssignTargetPaths" DependsOnTargets="FetchFfmpeg">
    <ItemGroup>
      <_FfmpegOut Include="$(FfmpegDir)*" />
      <None Include="@(_FfmpegOut)" Link="ffmpeg/%(_FfmpegOut.Filename)%(_FfmpegOut.Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
