@page "/browse"
@using AssetManager.AI.Enrichment
@using AssetManager.Core.Domain
@using AssetManager.Core.Search
@using AssetManager.Data.Search
@using AssetManager.Shared.Services
@implements IAsyncDisposable
@inject CatalogSearch Search
@inject AssetSearchService Words
@inject ICatalogStatsService Stats
@inject AssetManager.Data.CatalogStore Catalog
@inject PreviewCache Previews
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Browse</PageTitle>

<AssetDetailsDrawer AssetId="_details" OnClose="() => _details = null" />

<div style="display: flex; gap: 16px; align-items: flex-start">
    <MudPaper Outlined="true" Class="pa-3 browse-filters" id="browse-filters" Style="max-height: calc(100vh - 120px); overflow-y: auto">
        <MudTextField T="string" Value="_query.Text" ValueChanged="t => SetQuery(_query with { Text = string.IsNullOrWhiteSpace(t) ? null : t })"
                      Label="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" DebounceInterval="300"
                      Clearable="true" Margin="Margin.Dense" Variant="Variant.Outlined" id="search-text" />
        <MudTooltip Text="@(Search.SemanticAvailable ? "Rank by meaning instead of words" : "Needs the embedding model (Settings → AI model)")">
            <MudSwitch T="bool" Value="_query.Semantic" ValueChanged="v => SetQuery(_query with { Semantic = v })" Label="By meaning"
                       Disabled="!Search.SemanticAvailable" Color="Color.Primary" Class="search-semantic" />
        </MudTooltip>
        @if (_similarName is not null)
        {
            <MudChip T="string" Color="Color.Info" OnClose="_ => SetQuery(_query with { SimilarTo = null })" id="similar-chip">Similar to @_similarName</MudChip>
        }

        <MudText Typo="Typo.subtitle2" Class="mt-3">Type</MudText>
        <div style="display: flex; flex-wrap: wrap; gap: 2px" id="type-filter">
            @foreach (var type in Enum.GetValues<AssetType>())
            {
                var on = _query.Types.Contains(type);
                <MudChip T="string" Size="Size.Small" Variant="@(on ? Variant.Filled : Variant.Outlined)" Color="@(on ? Color.Primary : Color.Default)"
                         OnClick="() => ToggleType(type)" data-type="@type" Text="@type.ToString()" />
            }
        </div>

        <MudText Typo="Typo.subtitle2" Class="mt-3">Tags</MudText>
        <MudAutocomplete T="string" Label="Must have tag" SearchFunc="FindTagsAsync" ValueChanged="t => AddTag(t, include: true)" Margin="Margin.Dense"
                         Dense="true" ResetValueOnEmptyText="true" CoerceText="false" CoerceValue="true" Class="include-tag" />
        <MudAutocomplete T="string" Label="Must not have tag" SearchFunc="FindTagsAsync" ValueChanged="t => AddTag(t, include: false)" Margin="Margin.Dense"
                         Dense="true" ResetValueOnEmptyText="true" CoerceText="false" CoerceValue="true" Class="exclude-tag" />
        <div class="tag-editor mt-1" id="tag-filter">
            @foreach (var tag in _query.IncludeTags)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Text="@tag" OnClose="_ => SetQuery(_query with { IncludeTags = _query.IncludeTags.Where(t => t != tag).ToList() })" />
            }
            @foreach (var tag in _query.ExcludeTags)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined" Text="@("not " + tag)"
                         OnClose="_ => SetQuery(_query with { ExcludeTags = _query.ExcludeTags.Where(t => t != tag).ToList() })" />
            }
        </div>

        <MudSelect T="long?" Label="Collection" Value="_query.CollectionId" ValueChanged="v => SetQuery(_query with { CollectionId = v })" Margin="Margin.Dense"
                   Dense="true" Clearable="true" Class="mt-2" id="collection-filter">
            @foreach (var c in _collections)
            {
                <MudSelectItem T="long?" Value="c.Id">@c.Name (@c.Count)</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="long?" Label="Source" Value="_query.SourceId" ValueChanged="v => SetQuery(_query with { SourceId = v })" Margin="Margin.Dense"
                   Dense="true" Clearable="true" id="source-filter">
            @foreach (var s in _sources)
            {
                <MudSelectItem T="long?" Value="s.Id">@s.Name (@s.Count)</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="TriState?" Label="Commercial use" Value="_query.Commercial" ValueChanged="v => SetQuery(_query with { Commercial = v })" Margin="Margin.Dense"
                   Dense="true" Clearable="true" id="commercial-filter">
            <MudSelectItem T="TriState?" Value="TriState.Yes">Allowed</MudSelectItem>
            <MudSelectItem T="TriState?" Value="TriState.No">Not allowed</MudSelectItem>
            <MudSelectItem T="TriState?" Value="TriState.Unknown">Unknown</MudSelectItem>
        </MudSelect>
        <MudSelect T="TriState?" Label="Attribution" Value="_query.Attribution" ValueChanged="v => SetQuery(_query with { Attribution = v })" Margin="Margin.Dense"
                   Dense="true" Clearable="true" id="attribution-filter">
            <MudSelectItem T="TriState?" Value="TriState.Yes">Required</MudSelectItem>
            <MudSelectItem T="TriState?" Value="TriState.No">Not required</MudSelectItem>
            <MudSelectItem T="TriState?" Value="TriState.Unknown">Unknown</MudSelectItem>
        </MudSelect>
        <MudSelect T="AvailabilityFilter?" Label="Availability" Value="_query.Availability" ValueChanged="v => SetQuery(_query with { Availability = v })"
                   Margin="Margin.Dense" Dense="true" Clearable="true" id="availability-filter">
            <MudSelectItem T="AvailabilityFilter?" Value="AvailabilityFilter.Available">Original available</MudSelectItem>
            <MudSelectItem T="AvailabilityFilter?" Value="AvailabilityFilter.Unavailable">Original unavailable</MudSelectItem>
            <MudSelectItem T="AvailabilityFilter?" Value="AvailabilityFilter.Stored">Stored in catalog</MudSelectItem>
        </MudSelect>
        <MudSelect T="AiStatus?" Label="AI enrichment" Value="_query.AiStatus" ValueChanged="v => SetQuery(_query with { AiStatus = v })" Margin="Margin.Dense"
                   Dense="true" Clearable="true" id="ai-filter">
            @foreach (var status in Enum.GetValues<AiStatus>())
            {
                <MudSelectItem T="AiStatus?" Value="status">@status</MudSelectItem>
            }
        </MudSelect>

        <MudText Typo="Typo.subtitle2" Class="mt-3">Model issues</MudText>
        <MudCheckBox T="bool" Value="_query.ScaleAnomaly" ValueChanged="v => SetQuery(_query with { ScaleAnomaly = v })" Label="Scale anomaly" Dense="true" Size="Size.Small" />
        <MudCheckBox T="bool" Value="_query.OrientationUncertain" ValueChanged="v => SetQuery(_query with { OrientationUncertain = v })" Label="Orientation uncertain" Dense="true" Size="Size.Small" />
        <MudCheckBox T="bool" Value="_query.OrientationNotVerified" ValueChanged="v => SetQuery(_query with { OrientationNotVerified = v })" Label="Orientation not verified" Dense="true" Size="Size.Small" />
        <MudCheckBox T="bool" Value="_query.TexturesMissing" ValueChanged="v => SetQuery(_query with { TexturesMissing = v })" Label="Textures missing" Dense="true" Size="Size.Small" />

        <MudSelect T="SearchSort" Label="Sort" Value="_query.Sort" ValueChanged="v => SetQuery(_query with { Sort = v })" Margin="Margin.Dense" Dense="true" Class="mt-2" id="sort">
            <MudSelectItem T="SearchSort" Value="SearchSort.Relevance">Relevance</MudSelectItem>
            <MudSelectItem T="SearchSort" Value="SearchSort.Newest">Newest</MudSelectItem>
            <MudSelectItem T="SearchSort" Value="SearchSort.Name">Name</MudSelectItem>
        </MudSelect>
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.FilterAltOff" Disabled="_query.IsEmpty" OnClick="() => SetQuery(new SearchQuery())"
                   Class="mt-2" id="clear-filters">Clear filters</MudButton>
    </MudPaper>

    <div style="flex: 1; min-width: 0">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2" Style="min-height: 40px">
            <MudText Typo="Typo.h6" id="result-count">@(_total is { } t ? $"{t:N0} asset{(t == 1 ? "" : "s")}" : "…")</MudText>
            @if (_selected.Count > 0)
            {
                <MudChip T="string" Color="Color.Primary" id="selected-count" OnClose="_ => ClearSelection()">@_selected.Count.ToString("N0") selected</MudChip>
                <BulkActionBar Selection="_selected" OnDeleted="ClearSelection" />
            }
            <MudSpacer />
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.SelectAll" OnClick="SelectAllAsync"
                       Disabled="_total is null or 0" id="select-all">Select all</MudButton>
        </MudStack>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-2" id="browse-error">@_error</MudAlert>
        }
        <div @ref="_grid" class="browse-grid" tabindex="0" @onkeydown="OnKeyDown" @onkeydown:preventDefault="_preventKey"
             style="height: calc(100vh - 180px); overflow-y: auto; outline: none" id="browse-grid">
            <Virtualize @ref="_virtualize" TItem="Row" ItemsProvider="LoadRowsAsync" ItemSize="RowHeight" OverscanCount="3" Context="row">
                <ItemContent>
                    <div class="browse-row" style="height: @(RowHeight)px">
                        @for (var i = 0; i < row.Items.Count; i++)
                        {
                            var index = row.Start + i;
                            var a = row.Items[i];
                            <AssetCard @key="a.Id" AssetId="a.Id" Name="@a.Name" Type="a.Type" PreviewUrl="Previews.ThumbnailAsync" ModelViews="Previews.ModelViewsAsync" PreviewVersion="_previewVersion"
                                       Selectable="true" Selected="_selected.Contains(a.Id)" SelectedChanged="v => Toggle(a.Id, index, v)"
                                       OnClick="e => OnCardClickAsync(e, a.Id, index)" OnOpen="OpenAsync" Badges="Badges(a)" Overlay="Overlay(a)" />
                        }
                    </div>
                </ItemContent>
                <Placeholder>
                    <div class="browse-row" style="height: @(RowHeight)px">
                        @for (var i = 0; i < _columns; i++)
                        {
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="168px" Height="200px" />
                        }
                    </div>
                </Placeholder>
                <EmptyContent>
                    <MudText Class="mud-text-secondary pa-4" id="browse-empty">
                        @(_query.IsEmpty ? "The catalog is empty — import some assets first." : "No assets match these filters.")
                    </MudText>
                </EmptyContent>
            </Virtualize>
        </div>
    </div>
</div>

@code {
    /// <summary>Card height plus the row gap; Virtualize needs a fixed row size.</summary>
    public const int RowHeight = 220;
    private const int CardWidth = 168, Gap = 8;

    public sealed record Row(int Start, IReadOnlyList<AssetSummary> Items);

    [SupplyParameterFromQuery(Name = "q")] public string? Token { get; set; }

    private SearchQuery _query = new();
    private int? _total;
    private int _columns = 4;
    private string? _error;
    private string? _similarName;
    private readonly HashSet<long> _selected = [];
    private int? _anchor;
    private long? _playing;
    private bool _preventKey;
    private int _previewVersion; // bumped when the catalog changes, so cards reload regenerated previews
    private IReadOnlyList<CollectionCount> _collections = [];
    private IReadOnlyList<SourceCount> _sources = [];
    private IReadOnlyList<string> _tags = [];
    private ElementReference _grid;
    private Virtualize<Row>? _virtualize;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Browse>? _self;

    /// <summary>The assets selected in the grid (the bulk action bar works on these).</summary>
    public IReadOnlyCollection<long> Selected => _selected;

    protected override async Task OnInitializedAsync()
    {
        Catalog.ContentChanged += OnCatalogChanged;
        await LoadFilterOptionsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var query = SearchQuery.FromToken(Token);
        if (query == _query) return;
        _query = query;
        await ApplyQueryAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _self = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/AssetManager.Shared/js/browse.js");
            var columns = await _module.InvokeAsync<int>("observeWidth", _grid, _self, CardWidth, Gap);
            if (columns > 0) await ColumnsChanged(columns);
        }
        catch (JSException) { }
        catch (InvalidOperationException) { } // prerendering / no JS
    }

    [JSInvokable]
    public async Task ColumnsChanged(int columns)
    {
        if (columns == _columns) return;
        _columns = columns;
        await InvokeAsync(RefreshAsync);
    }

    private async ValueTask<ItemsProviderResult<Row>> LoadRowsAsync(ItemsProviderRequest request)
    {
        var columns = _columns;
        try
        {
            var page = await Search.SearchAsync(_query, request.StartIndex * columns, request.Count * columns, request.CancellationToken);
            var rows = page.Items.Chunk(columns).Select((items, i) => new Row((request.StartIndex + i) * columns, items)).ToList();
            if (_total != page.Total || _error is not null)
            {
                _total = page.Total;
                _error = null;
                _ = InvokeAsync(StateHasChanged);
            }
            return new ItemsProviderResult<Row>(rows, (page.Total + columns - 1) / columns);
        }
        catch (InvalidOperationException e)
        {
            _error = e.Message;
            _total = 0;
            _ = InvokeAsync(StateHasChanged);
            return new ItemsProviderResult<Row>([], 0);
        }
    }

    private async Task RefreshAsync()
    {
        if (_virtualize is not null) await _virtualize.RefreshDataAsync();
        StateHasChanged();
    }

    private async Task ApplyQueryAsync()
    {
        _selected.Clear();
        _anchor = null;
        _total = null;
        _similarName = null;
        if (_query.SimilarTo is { } similar)
            _similarName = await NameOfAsync(similar) ?? $"#{similar}";
        await RefreshAsync();
    }

    private async Task<string?> NameOfAsync(long id)
    {
        await using var db = Catalog.CreateDbContext();
        return await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.FirstOrDefaultAsync(db.Assets.Where(a => a.Id == id).Select(a => a.Name));
    }

    /// <summary>Changes the filters; the URL follows so a search can be bookmarked and Back works.</summary>
    private async Task SetQuery(SearchQuery query)
    {
        if (query == _query) return;
        _query = query;
        Nav.NavigateTo("browse" + (query.IsEmpty && query.Sort == SearchSort.Relevance ? "" : "?q=" + query.ToToken()), replace: true);
        await ApplyQueryAsync();
    }

    private Task ToggleType(AssetType type) => SetQuery(_query with
    {
        Types = _query.Types.Contains(type) ? _query.Types.Where(t => t != type).ToList() : [.. _query.Types, type],
    });

    private Task AddTag(string? tag, bool include)
    {
        tag = tag?.Trim();
        if (string.IsNullOrEmpty(tag)) return Task.CompletedTask;
        return include
            ? SetQuery(_query with { IncludeTags = _query.IncludeTags.Contains(tag) ? _query.IncludeTags : [.. _query.IncludeTags, tag] })
            : SetQuery(_query with { ExcludeTags = _query.ExcludeTags.Contains(tag) ? _query.ExcludeTags : [.. _query.ExcludeTags, tag] });
    }

    private Task<IEnumerable<string>> FindTagsAsync(string? text, CancellationToken ct)
    {
        IEnumerable<string> found = string.IsNullOrWhiteSpace(text) ? _tags : _tags.Where(t => t.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(found.Take(50));
    }

    private async Task LoadFilterOptionsAsync()
    {
        try
        {
            _collections = await Stats.CollectionsAsync();
            _sources = await Stats.SourcesAsync();
            _tags = (await Stats.TagsAsync()).Select(t => t.Name).ToList();
        }
        catch (Exception e) when (e is InvalidOperationException or Microsoft.Data.Sqlite.SqliteException)
        {
            _error = $"Could not read the catalog: {e.Message}";
        }
    }

    private void OnCatalogChanged() => InvokeAsync(async () =>
    {
        _previewVersion++;
        _selected.IntersectWith(await Words.MatchingIdsAsync(new SearchQuery(), _selected));
        await LoadFilterOptionsAsync();
        await RefreshAsync();
    });

    // ---- selection: click selects one, Ctrl toggles, Shift extends a range from the last clicked card ----

    private async Task OnCardClickAsync(MouseEventArgs e, long id, int index)
    {
        if (e.ShiftKey && _anchor is { } anchor)
        {
            var from = Math.Min(anchor, index);
            var range = await IdsAsync(from, Math.Abs(index - anchor) + 1);
            if (!(e.CtrlKey || e.MetaKey)) _selected.Clear();
            _selected.UnionWith(range);
            return;
        }
        if (e.CtrlKey || e.MetaKey)
        {
            if (!_selected.Remove(id)) _selected.Add(id);
        }
        else
        {
            _selected.Clear();
            _selected.Add(id);
        }
        _anchor = index;
    }

    private void Toggle(long id, int index, bool on)
    {
        if (on) _selected.Add(id);
        else _selected.Remove(id);
        _anchor = index;
    }

    private async Task SelectAllAsync()
    {
        _selected.UnionWith(CatalogSearch.IsSemantic(_query) ? await IdsAsync(0, _total ?? int.MaxValue) : await Words.MatchingIdsAsync(_query));
    }

    private void ClearSelection()
    {
        _selected.Clear();
        _anchor = null;
    }

    private async Task<IEnumerable<long>> IdsAsync(int skip, int take) => (await Search.SearchAsync(_query, skip, take)).Items.Select(i => i.Id);

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        _preventKey = false;
        if ((e.CtrlKey || e.MetaKey) && e.Key is "a" or "A")
        {
            _preventKey = true;
            await SelectAllAsync();
        }
        else if (e.Key == "Escape") ClearSelection();
    }

    // ---- card extras ----

    private long? _details;

    private void OpenAsync(long id) => _details = id;

    private RenderFragment Badges(AssetSummary a) => __builder =>
    {
        if (a.IsStored)
        {
            <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Small" Color="Color.Success" title="Stored in the catalog" />
        }
        if (a.ScaleAnomaly != ScaleAnomaly.None || a.TexturesMissing || a.OrientationUncertain)
        {
            <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Color="Color.Warning" title="@IssueText(a)" Class="issue-badge" />
        }
        if (a.AiStatus == AiStatus.Failed)
        {
            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" Color="Color.Error" title="AI enrichment failed" />
        }
    };

    private static string IssueText(AssetSummary a) => string.Join(", ", new[]
    {
        a.ScaleAnomaly != ScaleAnomaly.None ? $"Scale: {a.ScaleAnomaly}" : null,
        a.OrientationUncertain ? "Orientation uncertain" : null,
        a.TexturesMissing ? "Textures missing" : null,
    }.OfType<string>());

    private RenderFragment? Overlay(AssetSummary a)
    {
        var audio = a.Type is AssetType.Audio or AssetType.Music;
        var similar = a.AiStatus == AiStatus.Enriched;
        if (!audio && !similar) return null;
        return __builder =>
        {
            if (similar)
            {
                <MudIconButton Icon="@Icons.Material.Filled.ImageSearch" Size="Size.Small" title="Find similar" Class="find-similar"
                               OnClick="() => SetQuery(new SearchQuery { SimilarTo = a.Id })" />
            }
            if (audio)
            {
                <MudIconButton Icon="@(_playing == a.Id ? Icons.Material.Filled.Stop : Icons.Material.Filled.PlayArrow)" Size="Size.Small"
                               title="@(_playing == a.Id ? "Stop" : "Play")" Class="play-audio" Color="Color.Primary" OnClick="() => TogglePlayAsync(a.Id)" />
            }
        };
    }

    private async Task TogglePlayAsync(long id)
    {
        if (_module is null) return;
        if (_playing == id)
        {
            _playing = null;
            await _module.InvokeVoidAsync("stop");
            return;
        }
        var url = await Previews.AudioClipAsync(id);
        if (url is null)
        {
            Snackbar.Add("This sound has no preview clip.", Severity.Info);
            return;
        }
        _playing = id;
        if (!await _module.InvokeAsync<bool>("play", url, _self))
        {
            _playing = null;
            Snackbar.Add("The preview clip could not be played.", Severity.Warning);
        }
    }

    [JSInvokable]
    public Task PlaybackEnded() => InvokeAsync(() =>
    {
        _playing = null;
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        Catalog.ContentChanged -= OnCatalogChanged;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unobserve");
                await _module.InvokeVoidAsync("stop");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
    }
}
