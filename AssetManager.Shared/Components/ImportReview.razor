@using AssetManager.AI.Import
@using AssetManager.Core.Domain
@using AssetManager.Core.Jobs
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject ImportReviewService Review
@inject IProgressHub Hub
@inject ISnackbar Snackbar
@inject ILogger<ImportReview> Log

@* The import wizard's Preview/Review step: staged items grouped by source, with live AI results. *@
@if (_model is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2" id="review-summary">
        @_model.Assets assets in @_model.Sources.Count(s => s.Id != 0) sources · @_model.Included included · @_model.Sources.Sum(s => s.Skips.Count) skipped
    </MudText>

    @if (_selected.Count > 0)
    {
        <MudPaper Elevation="2" Class="pa-2 mb-3" Style="position: sticky; top: 56px; z-index: 5" id="review-bulk">
            <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                <MudText Typo="Typo.body2" id="selected-count">@_selected.Count selected</MudText>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => SetIncludedAsync(true)" id="include-selected">Include</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => SetIncludedAsync(false)" id="exclude-selected">Exclude</MudButton>
                <MudTooltip Text="The files of the other selected items become companions of the first one">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="_selected.Count < 2" OnClick="MergeAsync" id="merge-selected">Merge into one</MudButton>
                </MudTooltip>
                <MudTextField T="string" @bind-Value="_correction" Placeholder="Tell the AI what to change for the selected items" Immediate="true"
                              Margin="Margin.Dense" Style="min-width: 320px" Class="flex-grow-1" id="ai-correction" />
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoAwesome"
                           Disabled="string.IsNullOrWhiteSpace(_correction)" OnClick="CorrectAsync" id="ask-ai">Ask AI</MudButton>
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Close" aria-label="Clear selection" OnClick="() => _selected.Clear()" id="clear-selection" />
            </MudStack>
        </MudPaper>
    }

    @foreach (var source in _model.Sources)
    {
        <MudPaper Outlined="true" Class="pa-3 mb-3 review-source" data-source="@source.Id">
            <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                <MudIcon Icon="@SourceIcon(source.Kind)" />
                <MudText Typo="Typo.h6" Class="review-source-name">@source.Name</MudText>
                @if (source.Id != 0)
                {
                    <LicenseBadge License="source.License" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@source.Items.Count(i => i.Included) of @source.Items.Count included</MudText>
                    <MudSpacer />
                    @if (source.Items.Count > 0)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => SelectAll(source)">Select all</MudButton>
                    }
                }
            </MudStack>
            @if (!string.IsNullOrWhiteSpace(source.Description))
            {
                <MudText Typo="Typo.body2" Class="mt-1">@source.Description</MudText>
            }
            @if (!string.IsNullOrWhiteSpace(source.Notes))
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@source.Notes</MudText>
            }
            @if (source.Error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@source.Error</MudAlert>
            }
            @if (source.Replacement is { } r)
            {
                <MudAlert Severity="@(r.Accepted == false ? Severity.Normal : Severity.Info)" Dense="true" Class="mt-2 review-replacement">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                        <div>
                        <MudText Typo="Typo.body2">
                            @if (r.Accepted == false)
                            {
                                <span>Imported as a new source (not replacing <b>@r.OldName</b>).</span>
                            }
                            else
                            {
                                <span>Looks like a new version of <b>@r.OldName</b>@(r.Score > 0 ? $" ({r.Score:P0} match)" : ""): replaces it on confirm.</span>
                            }
                        </MudText>
                        <MudText Typo="Typo.caption" Class="replacement-counts">@r.Updated updated · @r.Added added · @r.Removed removed</MudText>
                        </div>
                        @if (r.Accepted == false)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => ReplaceAsync(source.Id, true, null)" Class="accept-replacement">Replace @r.OldName</MudButton>
                        }
                        else
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => ReplaceAsync(source.Id, false, null)" Class="decline-replacement">Import as new</MudButton>
                        }
                    </MudStack>
                </MudAlert>
            }
            @if (source.Id != 0 && source.Kind is SourceKind.UnityPackage or SourceKind.Archive or SourceKind.Folder)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-1">
                    <MudAutocomplete T="SourceOption" Label="@(source.Replacement is null ? "Replaces a cataloged source (optional)" : "Replace a different source")"
                                     SearchFunc="FindSourcesAsync" ToStringFunc="o => o?.Name" ValueChanged="o => PickReplacementAsync(source.Id, o)"
                                     Margin="Margin.Dense" Dense="true" ResetValueOnEmptyText="true" Style="max-width: 360px" Class="pick-replacement" />
                </MudStack>
            }

            <div style="display: flex; flex-wrap: wrap; gap: 8px" class="mt-2">
                @foreach (var item in Visible(source))
                {
                    <AssetCard AssetId="item.Id" Name="@item.Name" Type="item.Type" PreviewUrl="PreviewUrlAsync" PreviewVersion="_previewVersion"
                               Selectable="true" Selected="_selected.Contains(item.Id)" SelectedChanged="v => Toggle(item.Id, v)" Dimmed="!item.Included"
                               OnOpen="Open">
                        <Badges>
                            @if (item.Duplicate)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text" Class="ma-0 duplicate-badge">already cataloged</MudChip>
                            }
                            else if (item.Unchanged)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0 unchanged-badge">unchanged</MudChip>
                            }
                            @if (!item.Included)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0 excluded-badge">excluded</MudChip>
                            }
                            @if (item.Companions > 0)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">+@item.Companions files</MudText>
                            }
                            <span title="@AiText(item)" class="ai-status" style="display: inline-flex">
                                <MudIcon Icon="@AiIcon(item.AiStatus)" Size="Size.Small" Color="@(item.AiStatus == AiStatus.Failed ? Color.Error : Color.Default)" />
                            </span>
                        </Badges>
                    </AssetCard>
                }
            </div>
            @if (source.Items.Count > Visible(source).Count())
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" Class="mt-1" OnClick="() => _expanded.Add(source.Id)">Show all @source.Items.Count</MudButton>
            }

            @if (_open is { } open && source.Items.FirstOrDefault(i => i.Id == open) is { } edit)
            {
                <MudPaper Outlined="true" Class="pa-3 mt-3" id="item-editor">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" Label="Name" @bind-Value="_editName" id="edit-name" />
                            <MudSelect T="AssetType" Label="Type" @bind-Value="_editType" id="edit-type">
                                @foreach (var t in Enum.GetValues<AssetType>())
                                {
                                    <MudSelectItem Value="t">@t</MudSelectItem>
                                }
                            </MudSelect>
                            <MudTextField T="string" Label="Description" @bind-Value="_editDescription" Lines="3" AutoGrow="true" id="edit-description" />
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@AiText(edit)</MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.subtitle2">Tags</MudText>
                            <TagEditor Tags="edit.Tags" OnAdd="t => AddTagAsync(edit.Id, t)" OnRemove="t => RemoveTagAsync(edit.Id, t)" />
                            <MudText Typo="Typo.subtitle2" Class="mt-2">Files</MudText>
                            @foreach (var file in edit.Files)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudText Typo="Typo.caption" Class="flex-grow-1" Style="overflow-wrap: anywhere">
                                        @(file.Role == FileRole.Primary ? "● " : "○ ")@file.RelativePath
                                    </MudText>
                                    @if (file.Role == FileRole.Companion)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => SplitAsync(file.Id)" Class="split-file">Own item</MudButton>
                                    }
                                </MudStack>
                            }
                            @if (edit.PreviewError is not null)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@edit.PreviewError</MudAlert>
                            }
                        </MudItem>
                    </MudGrid>
                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-2">
                        <MudSwitch T="bool" Value="edit.Included" ValueChanged="v => SetIncludedAsync([edit.Id], v)" Color="Color.Primary" Label="Include" id="edit-included" />
                        <MudButton Variant="Variant.Text" OnClick="() => _open = null">Close</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => SaveAsync(edit)" id="edit-save">Save</MudButton>
                    </MudStack>
                </MudPaper>
            }

            @if (source.Skips.Count > 0)
            {
                <MudExpansionPanels Elevation="0" Class="mt-2">
                    <MudExpansionPanel Text="@($"{source.Skips.Count} skipped")" Class="review-skips">
                        <MudSimpleTable Dense="true" Hover="true">
                            <tbody>
                                @foreach (var skip in source.Skips)
                                {
                                    <tr><td style="overflow-wrap: anywhere">@skip.Path</td><td>@skip.Reason</td></tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        </MudPaper>
    }
}

@code {
    [Parameter, EditorRequired] public long SessionId { get; set; }

    /// <summary>Items shown per source before "Show all".</summary>
    [Parameter] public int PageSize { get; set; } = 48;

    public sealed record SourceOption(long Id, string Name);

    private ReviewModel? _model;
    private readonly HashSet<long> _selected = [];
    private readonly HashSet<long> _expanded = [];
    private string? _correction;
    private int _previewVersion;

    private long? _open;
    private string _editName = "";
    private string? _editDescription;
    private AssetType _editType;

    private CancellationTokenSource? _reloadDelay;

    protected override async Task OnInitializedAsync()
    {
        Hub.Changed += OnJobChanged;
        Hub.Finished += OnJobChanged;
        await ReloadAsync();
    }

    public async Task ReloadAsync()
    {
        _model = await Review.LoadAsync(SessionId);
        if (_model is not null)
        {
            var ids = _model.Sources.SelectMany(s => s.Items).Select(i => i.Id).ToHashSet();
            _selected.IntersectWith(ids);
            if (_open is { } o && !ids.Contains(o)) _open = null;
        }
    }

    private IEnumerable<ReviewItem> Visible(ReviewSource source) =>
        _expanded.Contains(source.Id) ? source.Items : source.Items.Take(PageSize);

    private async Task<string?> PreviewUrlAsync(long id) =>
        await Review.PreviewAsync(id) is { } p ? $"data:{p.Mime};base64,{Convert.ToBase64String(p.Bytes)}" : null;

    private void Toggle(long id, bool on)
    {
        if (on) _selected.Add(id);
        else _selected.Remove(id);
    }

    private void SelectAll(ReviewSource source) => _selected.UnionWith(source.Items.Select(i => i.Id));

    private void Open(long id)
    {
        var item = _model?.Sources.SelectMany(s => s.Items).FirstOrDefault(i => i.Id == id);
        if (item is null) return;
        _open = id;
        (_editName, _editDescription, _editType) = (item.Name, item.Description, item.Type);
    }

    private async Task SaveAsync(ReviewItem item)
    {
        var name = _editName.Trim();
        var update = new AssetUpdate
        {
            Name = name.Length > 0 && name != item.Name ? name : null,
            Description = _editDescription != item.Description ? _editDescription?.Trim() : null,
            Type = _editType != item.Type ? _editType : null,
        };
        if (update.Name is null && update.Description is null && update.Type is null) { _open = null; return; }
        await RunAsync(() => Review.EditAsync(item.Id, update));
        _open = null;
    }

    private Task SetIncludedAsync(IReadOnlyCollection<long> ids, bool included) => RunAsync(() => Review.SetIncludedAsync(ids, included));

    private Task SetIncludedAsync(bool included) => SetIncludedAsync(_selected.ToList(), included);

    private Task AddTagAsync(long id, string tag) => RunAsync(() => Review.AddTagAsync([id], tag));

    private Task RemoveTagAsync(long id, string tag) => RunAsync(() => Review.RemoveTagAsync([id], tag));

    private async Task MergeAsync()
    {
        // The first selected item in display order keeps its identity; the others become its companions.
        var order = _model!.Sources.SelectMany(s => s.Items).Select(i => i.Id).ToList();
        var ids = _selected.OrderBy(order.IndexOf).ToList();
        await RunAsync(() => Review.MergeAsync(ids[0], ids));
        _selected.Clear();
        _previewVersion++;
    }

    private async Task SplitAsync(long fileId)
    {
        await RunAsync(() => Review.SplitAsync(fileId));
        _previewVersion++;
    }

    private async Task CorrectAsync()
    {
        var ids = _selected.ToList();
        await RunAsync(async () =>
        {
            await Review.CorrectAsync(SessionId, ids, _correction!);
            Snackbar.Add($"Asked the AI to revise {ids.Count} item{(ids.Count == 1 ? "" : "s")}; results appear as they arrive.", Severity.Info);
            _correction = null;
        });
    }

    private Task ReplaceAsync(long sourceId, bool accepted, long? oldSourceId) =>
        RunAsync(() => Review.SetReplacementAsync(sourceId, accepted, oldSourceId));

    private async Task PickReplacementAsync(long sourceId, SourceOption? option)
    {
        if (option is not null) await ReplaceAsync(sourceId, true, option.Id);
    }

    private async Task<IEnumerable<SourceOption>> FindSourcesAsync(string? text, CancellationToken ct) =>
        (await Review.FindSourcesAsync(text, ct)).Select(s => new SourceOption(s.Id, s.Name));

    /// <summary>Runs a user action, reports failures and shows the new state.</summary>
    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception e) when (e is InvalidOperationException or ArgumentException)
        {
            Snackbar.Add(e.Message, Severity.Warning);
        }
        await ReloadAsync();
    }

    /// <summary>AI results and job progress arrive while the review is open: reload, at most every 1.5 s.</summary>
    private void OnJobChanged(JobSnapshot job)
    {
        if (job.Type is not (ImportJob.JobType or AssetManager.Processing.Jobs.JobTypes.Enrich)) return;
        if (_reloadDelay is not null) return;
        var cts = _reloadDelay = new CancellationTokenSource();
        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(1500, cts.Token);
                _reloadDelay = null;
                await ReloadAsync();
                _previewVersion += job.State is JobState.Completed ? 1 : 0;
                StateHasChanged();
            }
            catch (OperationCanceledException) { }
            catch (Exception e) { Log.LogError(e, "Import review refresh failed"); }
        });
    }

    private static string SourceIcon(SourceKind kind) => kind switch
    {
        SourceKind.UnityPackage => Icons.Material.Filled.Inventory2,
        SourceKind.Archive => Icons.Material.Filled.FolderZip,
        SourceKind.File => Icons.Material.Filled.InsertDriveFile,
        _ => Icons.Material.Filled.Folder,
    };

    private static string AiIcon(AiStatus status) => status switch
    {
        AiStatus.Enriched => Icons.Material.Filled.AutoAwesome,
        AiStatus.Pending => Icons.Material.Filled.HourglassEmpty,
        AiStatus.Failed => Icons.Material.Filled.ErrorOutline,
        _ => Icons.Material.Filled.Remove,
    };

    private static string AiText(ReviewItem item) => item.AiStatus switch
    {
        AiStatus.Enriched => "AI enriched",
        AiStatus.Pending => "Waiting for the AI",
        AiStatus.Failed => $"AI failed: {item.AiError}",
        _ => "Not enriched by AI",
    };

    public void Dispose()
    {
        Hub.Changed -= OnJobChanged;
        Hub.Finished -= OnJobChanged;
        _reloadDelay?.Cancel();
    }
}
