@using AssetManager.Core.Jobs
@using AssetManager.Processing.Jobs
@inject IJobQueue Jobs
@inject Services.UiActions Ui

<MudPaper Class="pa-4" Outlined="true">
    <MudText Typo="Typo.h6" Class="mb-2">Maintenance</MudText>
    <MudText Typo="Typo.body2" Class="mb-3">These run as background jobs; follow them on the Jobs page.</MudText>
    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RegenerateAsync" id="regenerate-outdated">Regenerate outdated previews</MudButton>
    </MudStack>
</MudPaper>

@code {
    private Task RegenerateAsync() => Ui.RunAsync(() =>
        Jobs.EnqueueAsync(JobTypes.RegeneratePreviews, "Regenerate outdated previews", new AssetsPayload(null)));
}
