@inject IAppSettingsStore Settings

<MudTooltip Text="@($"Theme: {Settings.Current.Theme}")">
    <MudIconButton Icon="@Icon" Color="Color.Inherit" OnClick="Cycle" aria-label="Switch theme" />
</MudTooltip>

@code {
    private string Icon => Settings.Current.Theme switch
    {
        ThemeMode.Dark => Icons.Material.Filled.DarkMode,
        ThemeMode.Light => Icons.Material.Filled.LightMode,
        _ => Icons.Material.Filled.BrightnessAuto,
    };

    /// <summary>Cycles System → Light → Dark → System and persists the choice in the app settings.</summary>
    private void Cycle() => Settings.Update(s => s.Theme = s.Theme switch
    {
        ThemeMode.System => ThemeMode.Light,
        ThemeMode.Light => ThemeMode.Dark,
        _ => ThemeMode.System,
    });
}
