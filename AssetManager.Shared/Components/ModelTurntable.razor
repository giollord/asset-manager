@using AssetManager.Data.Services
@using AssetManager.Processing.Settings
@implements IAsyncDisposable
@inject PreviewQueries Previews
@inject PreviewSettings PreviewOptions
@inject IJSRuntime JS

@* A model's stored multi-angle renders as a turntable (spec "Inline audio and model inspection", design D18): dragging
   left and right turns it through the azimuths, up and down moves between elevation rings, and the arrow keys step it
   while it has focus. Works without the original. *@
@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
}
else if (_turntable is not { } t)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary" id="turntable-none">No stored renders.</MudText>
}
else
{
    <div @ref="_element" class="model-turntable preview-surface" tabindex="0" id="@Id" style="height: @Height"
         data-rings="@t.Rings" data-azimuths="@t.Azimuths" data-primary="@t.Primary"
         title="Drag left or right to turn, up or down to tilt; arrow keys step it" aria-label="Model renders: drag to turn">
        @for (var i = 0; i < t.Views.Count; i++)
        {
            <img class="turntable-view" src="@t.Views[i].DataUrl" alt="" draggable="false" data-index="@i" hidden="@(i != t.Primary)" />
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public long AssetId { get; set; }

    [Parameter] public string Height { get; set; } = "320px";

    [Parameter] public string Id { get; set; } = "model-turntable";

    /// <summary>Changes when the renders should be loaded again (e.g. after a re-render).</summary>
    [Parameter] public int Version { get; set; }

    private TurntableViews? _turntable;
    private bool _loading = true;
    private (long, int)? _loaded;
    private bool _init;
    private ElementReference _element;
    private IJSObjectReference? _module, _handle;

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded == (AssetId, Version)) return;
        _loaded = (AssetId, Version);
        _loading = true;
        var o = await PreviewOptions.GetAsync();
        _turntable = await Previews.ModelTurntableAsync(AssetId, o.Elevations.Count, o.AzimuthsPerRing, o.PrimaryViewIndex);
        _loading = false;
        _init = _turntable is not null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_init) return;
        _init = false;
        try
        {
            if (_handle is not null) await _handle.InvokeVoidAsync("dispose");
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/AssetManager.Shared/js/turntable.js");
            _handle = await _module.InvokeAsync<IJSObjectReference?>("init", _element, _turntable!.Rings, _turntable.Azimuths, _turntable.Primary);
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_handle is not null)
            {
                await _handle.InvokeVoidAsync("dispose");
                await _handle.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
