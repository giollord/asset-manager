@using AssetManager.Processing.Models
@using AssetManager.Shared.Services
@implements IRenderHost
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject WebViewModelRenderer Renderer

@* Hidden: the renderer draws into an off-screen canvas. Mounted once in MainLayout so it lives as long as the app. *@

@code {
    private const long MaxResultBytes = 256L * 1024 * 1024;
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/AssetManager.Shared/js/modelRenderer.js");
        Renderer.Attach(this);
    }

    public async Task<IReadOnlyList<RenderedView>> RenderAsync(ModelRenderRequest request, CancellationToken ct)
    {
        IReadOnlyList<RenderedView> views = [];
        await InvokeAsync(async () =>
        {
            using var glb = new DotNetStreamReference(new MemoryStream(request.Glb));
            var textures = Textures(request.Textures);
            try
            {
                var result = await Module.InvokeAsync<JsRenderResult>("renderViews", ct, glb, textures, new
                {
                    orientation = new { rotX = request.Orientation.RotX, rotY = request.Orientation.RotY, rotZ = request.Orientation.RotZ },
                    size = request.Size,
                    elevations = request.Elevations,
                    azimuths = request.Azimuths,
                    quality = request.Quality,
                    neutralMaterials = request.NeutralMaterials,
                });
                var parts = await SplitAsync(result, ct);
                views = parts.Select((p, i) => new RenderedView(i, result.Width, result.Height, p)).ToList();
            }
            finally
            {
                foreach (var t in textures) t.stream.Dispose();
            }
        });
        return views;
    }

    public async Task<RenderedView> RenderProbeAsync(ProbeRequest request, CancellationToken ct)
    {
        RenderedView? view = null;
        await InvokeAsync(async () =>
        {
            using var glb = new DotNetStreamReference(new MemoryStream(request.Glb));
            var textures = Textures(request.Textures);
            try
            {
                var result = await Module.InvokeAsync<JsRenderResult>("renderProbe", ct, glb, textures, new
                {
                    tileSize = request.TileSize,
                    quality = request.Quality,
                    neutralMaterials = request.NeutralMaterials,
                });
                view = new RenderedView(0, result.Width, result.Height, (await SplitAsync(result, ct))[0]);
            }
            finally
            {
                foreach (var t in textures) t.stream.Dispose();
            }
        });
        return view!;
    }

    public async Task<AnimationFrames> RenderAnimationAsync(AnimationRenderRequest request, CancellationToken ct)
    {
        AnimationFrames? frames = null;
        await InvokeAsync(async () =>
        {
            using var glb = new DotNetStreamReference(new MemoryStream(request.Glb));
            var textures = Textures(request.Textures);
            try
            {
                var result = await Module.InvokeAsync<JsRenderResult>("renderAnimation", ct, glb, textures, new
                {
                    orientation = new { rotX = request.Orientation.RotX, rotY = request.Orientation.RotY, rotZ = request.Orientation.RotZ },
                    size = request.Size,
                    fps = request.Fps,
                    maxSeconds = request.MaxSeconds,
                    quality = request.Quality,
                    neutralMaterials = request.NeutralMaterials,
                });
                frames = new AnimationFrames(result.Width, result.Height, request.Fps, await SplitAsync(result, ct));
            }
            finally
            {
                foreach (var t in textures) t.stream.Dispose();
            }
        });
        return frames!;
    }

    private IJSObjectReference Module => _module ?? throw new RendererUnavailableException();

    private static List<TextureArg> Textures(IReadOnlyList<RenderTexture> textures) =>
        textures.Select(t => new TextureArg(t.Material, t.Slot, t.Mime, new DotNetStreamReference(new MemoryStream(t.Bytes)))).ToList();

    private static async Task<List<byte[]>> SplitAsync(JsRenderResult result, CancellationToken ct)
    {
        await using var stream = await result.Data.OpenReadStreamAsync(MaxResultBytes, ct);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer, ct);
        await result.Data.DisposeAsync();
        var all = buffer.ToArray();
        var parts = new List<byte[]>(result.Lengths.Length);
        var at = 0;
        foreach (var len in result.Lengths)
        {
            parts.Add(all[at..(at + len)]);
            at += len;
        }
        return parts;
    }

    public async ValueTask DisposeAsync()
    {
        Renderer.Detach(this);
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }

    private sealed record TextureArg(string material, string slot, string mime, DotNetStreamReference stream);

    private sealed record JsRenderResult(int[] Lengths, int Width, int Height, IJSStreamReference Data);
}
