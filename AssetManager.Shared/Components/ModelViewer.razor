@using AssetManager.Core.Domain
@using AssetManager.Processing.Handlers
@using AssetManager.Processing.Models
@using AssetManager.Processing.Containers
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject PreviewService Previews

@* Interactive three.js viewer of a model's original (orbit with the mouse); the orientation can be changed live. *@
<div class="preview-surface model-viewer" style="position: relative; height: @(CssHeight ?? $"{Height}px"); border-radius: 4px">
    <div @ref="_canvas" style="width: 100%; height: 100%"></div>
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" Size="Size.Small" Style="position: absolute; left: 50%; top: 50%" />
    }
    @if (_error is not null)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary pa-3 viewer-error" Style="position: absolute; inset: 0">@_error</MudText>
    }
</div>

@code {
    [Parameter, EditorRequired] public long AssetId { get; set; }

    [Parameter] public int Height { get; set; } = 320;

    /// <summary>A CSS height instead of <see cref="Height"/>, e.g. "100%" to fill a dialog.</summary>
    [Parameter] public string? CssHeight { get; set; }

    /// <summary>The rotation shown (degrees about X, Y, Z); changes apply without reloading.</summary>
    [Parameter] public (int X, int Y, int Z) Rotation { get; set; }

    private ElementReference _canvas;
    private IJSObjectReference? _module, _viewer;
    private bool _loading = true;
    private string? _error;
    private (int, int, int)? _shown;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
            return;
        }
        if (_viewer is not null && _shown != Rotation) await ApplyRotationAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var request = await Previews.ViewerRequestAsync(AssetId);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/AssetManager.Shared/js/modelRenderer.js");
            using var glb = new DotNetStreamReference(new MemoryStream(request.Glb));
            var textures = request.Textures.Select(t => new TextureArg(t.Material, t.Slot, t.Mime, new DotNetStreamReference(new MemoryStream(t.Bytes)))).ToList();
            try
            {
                _viewer = await _module.InvokeAsync<IJSObjectReference>("createViewer", _canvas, glb, textures, new
                {
                    orientation = new { rotX = Rotation.X, rotY = Rotation.Y, rotZ = Rotation.Z },
                    neutralMaterials = request.NeutralMaterials,
                });
                _shown = Rotation;
            }
            finally
            {
                foreach (var t in textures) t.stream.Dispose();
            }
        }
        catch (OriginalUnavailableException e)
        {
            _error = $"The original is not available ({e.Missing}). Connect the drive or store the asset in the catalog to view it in 3D.";
        }
        catch (Exception e) when (e is IOException or JSException or InvalidOperationException or ContainerReadException)
        {
            _error = $"The model could not be shown: {e.Message}";
        }
        _loading = false;
        StateHasChanged();
    }

    private async Task ApplyRotationAsync()
    {
        _shown = Rotation;
        try
        {
            await _viewer!.InvokeVoidAsync("setOrientation", new { rotX = Rotation.X, rotY = Rotation.Y, rotZ = Rotation.Z });
        }
        catch (JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_viewer is not null)
            {
                await _viewer.InvokeVoidAsync("dispose");
                await _viewer.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }

    private sealed record TextureArg(string material, string slot, string mime, DotNetStreamReference stream);
}
