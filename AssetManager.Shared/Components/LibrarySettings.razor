@using AssetManager.Core.Domain
@using AssetManager.Core.Platform
@using AssetManager.Processing.Locations
@using AssetManager.Processing.Sync
@inject IAppSettingsStore Settings
@inject VolumeRegistry Locations
@inject IVolumeService Volumes
@inject IFolderPicker FolderPicker
@inject AssetManager.Core.Jobs.IJobQueue Jobs
@inject UiActions Ui
@inject ISnackbar Snackbar
@inject NavigationManager Nav

@* Library folders and the startup check (specs "Library folders", "When scans run"; design D11). *@
<MudPaper Class="pa-4" Outlined="true" id="library-settings">
    <MudText Typo="Typo.h6" Class="mb-2">@Title</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        Library folders are where new packs appear, such as a downloads or assets folder. Scanning them lists the folders, archives and
        <code>.unitypackage</code> files in them that are not imported yet, and marks new versions of imported packs. Nothing is imported until you choose to.
    </MudText>
    <MudList T="string" Dense="true" id="library-folders">
        @foreach (var folder in Settings.Current.LibraryFolders)
        {
            <MudListItem T="string" Class="library-folder">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Class="mud-text-secondary" />
                    <MudText Typo="Typo.body2" Class="selectable" Style="flex: 1">@Display(folder)</MudText>
                    @if (!Attached(folder))
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">drive not attached</MudChip>
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" title="Remove this library folder" Class="library-remove"
                                   OnClick="() => Remove(folder)" />
                </MudStack>
            </MudListItem>
        }
    </MudList>
    @if (Settings.Current.LibraryFolders.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary" id="library-empty">No library folders.</MudText>
    }
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-2">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CreateNewFolder" OnClick="PickAsync" id="library-add">Add folder</MudButton>
        <MudTextField T="string" @bind-Value="_draft" Placeholder="Or paste a folder path and press Enter" Immediate="true" OnKeyDown="OnKeyDown"
                      Margin="Margin.Dense" Style="max-width: 420px" id="library-path" />
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Sync" OnClick="ScanAsync" Disabled="Settings.Current.LibraryFolders.Count == 0" id="library-scan">Scan now</MudButton>
    </MudStack>
    <MudSwitch T="bool" Value="Settings.Current.CheckForChangesAtStartup" ValueChanged="v => Settings.Update(s => s.CheckForChangesAtStartup = v)" Color="Color.Primary"
               Label="Check for changes at startup" Class="mt-3" id="library-startup" />
    <MudText Typo="Typo.caption" Class="mud-text-secondary" HtmlTag="div">
        Shortly after the app starts, rescans the imported sources and scans the library folders in the background, and shows a notification when it finds something.
    </MudText>
</MudPaper>

@code {
    public const string Title = "Library";

    public static readonly string[] SearchTerms = [Title, "Library folders", "Add folder", "Scan now", "Check for changes at startup", "Rescan"];

    private string? _draft;

    private string Display(string folder)
    {
        var location = Location.Parse(folder);
        return location.Display(location.VolumeId is { } vol ? Volumes.GetRoot(vol) : null);
    }

    private bool Attached(string folder) => Location.Parse(folder) is var l && (l.VolumeId is null ? Directory.Exists(l.Path) : Volumes.GetRoot(l.VolumeId) is not null);

    private async Task PickAsync()
    {
        try
        {
            if (await FolderPicker.PickFolderAsync() is { } folder) await AddAsync(folder);
        }
        catch (PlatformFeatureNotSupportedException e) { Snackbar.Add(e.Message, Severity.Warning); }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(_draft)) return;
        var path = _draft.Trim().Trim('"');
        if (!Directory.Exists(path))
        {
            Snackbar.Add($"Folder not found: {path}", Severity.Warning);
            return;
        }
        await AddAsync(path);
        _draft = "";
    }

    /// <summary>
    /// Adds a folder as a volume-relative location, so it still matches when the drive letter changes; the volume's
    /// label is remembered so a detached drive can be named.
    /// </summary>
    public async Task AddAsync(string path)
    {
        var location = Locations.FromPath(path);
        if (Settings.Current.LibraryFolders.Contains(location.ToString(), StringComparer.OrdinalIgnoreCase)) return;
        await Locations.RememberAsync([location.VolumeId]);
        Settings.Update(s => s.LibraryFolders = [.. s.LibraryFolders, location.ToString()]);
    }

    private void Remove(string folder) => Settings.Update(s => s.LibraryFolders = s.LibraryFolders.Where(f => f != folder).ToList());

    private async Task ScanAsync()
    {
        if (await Ui.RunAsync(() => Jobs.EnqueueAsync(LibraryScanJob.JobType, "Scan library folders", new LibraryScanPayload())) > 0)
            Nav.NavigateTo(AssetManager.Shared.Pages.Sources.ChangesHref);
    }
}
