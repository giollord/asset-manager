@using AssetManager.Core.Jobs
@implements IDisposable
@inject IProgressHub Hub
@inject NavigationManager Nav

@* App-bar indicator (design D8): a chip with the active job count and combined progress that opens the Jobs page;
   hovering lists the jobs. Nothing at all while no job runs (spec "Global progress indicator"). *@
@if (_active.Count > 0)
{
    <div class="d-inline-block" @onmouseenter="() => SetOpen(true)" @onmouseleave="() => SetOpen(false)">
        <MudChip T="string" id="jobs-indicator" Class="jobs-chip mx-2" Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Small"
                 Icon="@Icons.Material.Filled.Sync" OnClick="@(() => Nav.NavigateTo("jobs"))" aria-label="Active jobs: open the Jobs page">
            @Label
        </MudChip>
        @* A popover in the app's own panel colors (a tooltip is light gray, which makes the purple progress unreadable). *@
        <MudPopover Open="_open" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Paper="true" Elevation="8" Class="pa-3"
                    Style="width: 380px; max-width: 90vw">
            <div id="jobs-quick-view">
                @foreach (var job in _active.Take(6))
                {
                    <div class="mb-3"><JobProgressView Job="job" Compact="true" /></div>
                }
                @if (_active.Count > 6)
                {
                    <MudText Typo="Typo.caption">and @(_active.Count - 6) more</MudText>
                }
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Click to open the Jobs page.</MudText>
            </div>
        </MudPopover>
    </div>
}

@code {
    private List<JobSnapshot> _active = [];
    private bool _open;

    /// <summary>Opens or closes the quick view; each job view there ticks its own elapsed time.</summary>
    private void SetOpen(bool open) => _open = open;

    /// <summary>Average progress of the active jobs whose progress is known.</summary>
    private double Combined => _active.Select(j => j.Fraction).OfType<double>().DefaultIfEmpty(0).Average();

    /// <summary>"2 jobs · 45%"; the percentage only once some job reports progress.</summary>
    private string Label => $"{_active.Count} job{(_active.Count == 1 ? "" : "s")}" +
                            (_active.Any(j => j.Fraction is not null) ? $" · {Combined * 100:0}%" : "");

    protected override void OnInitialized()
    {
        _active = Hub.Active.ToList();
        Hub.Changed += OnChanged;
    }

    private void OnChanged(JobSnapshot _) => InvokeAsync(() =>
    {
        _active = Hub.Active.ToList();
        StateHasChanged();
    });

    public void Dispose()
    {
        Hub.Changed -= OnChanged;
    }
}
