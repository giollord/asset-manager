@inherits LayoutComponentBase
@implements IDisposable
@inject IAppSettingsStore Settings
@inject AppStartup Startup
@inject AssetManager.Core.Platform.FileDropBroker Drops
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject AssetManager.Core.Platform.IWindowChrome Chrome

<MudThemeProvider @ref="_themeProvider" Theme="_theme" IsDarkMode="_isDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<JobNotifications />
<PreviewRenderHost />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true" Style="@AppBarStyle">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="() => _drawerOpen = !_drawerOpen" aria-label="Toggle navigation" />
        <img src="_content/AssetManager.Shared/logo-mark.svg" alt="" width="28" height="28" class="ml-2" />
        <MudText Typo="Typo.h6" Class="ml-2">Asset Manager</MudText>
        <MudSpacer />
        <JobsIndicator />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1" Variant="DrawerVariant.Mini" OpenMiniOnHover="false">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            @if (!_started)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                <MudText Class="mt-2">Opening catalog...</MudText>
            }
            else
            {
                @if (Startup.Error is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4">Startup problem: @Startup.Error.Message</MudAlert>
                }
                @Body
            }
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private MudThemeProvider? _themeProvider;
    private readonly MudTheme _theme = new();
    private bool _drawerOpen = true;
    private bool _isDark;
    private bool _systemDark;

    private bool _started;

    protected override async Task OnInitializedAsync()
    {
        Settings.Changed += OnSettingsChanged;
        Drops.Dropped += OnFilesDropped;
        Chrome.Changed += OnChromeChanged;
        Nav.LocationChanged += OnLocationChanged;
        _path = new Uri(Nav.Uri).AbsolutePath;
        _isDark = Settings.Current.Theme == ThemeMode.Dark;
        await Startup.EnsureStartedAsync();
        _started = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _themeProvider is not null)
        {
            _systemDark = await _themeProvider.GetSystemDarkModeAsync();
            await _themeProvider.WatchSystemDarkModeAsync(OnSystemDarkChanged);
            ApplyTheme();
            _layoutModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/AssetManager.Shared/js/layout.js");
            try
            {
                _selfRef = DotNetObjectReference.Create(this);
                var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/AssetManager.Shared/js/fileDrop.js");
                await module.InvokeVoidAsync("install", _selfRef);
            }
            catch (JSException) { } // drag and drop is optional
            if (Chrome.IsCustomTitleBar)
            {
                var chrome = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/AssetManager.Shared/js/windowChrome.js");
                await chrome.InvokeVoidAsync("watch", _selfRef);
            }
        }
    }

    /// <summary>
    /// The system caption buttons sit over the app bar's right end (spec "System caption buttons"), so the app bar
    /// keeps that width free. Nothing is reserved without a custom title bar (spec "Browser host unchanged").
    /// </summary>
    private string? AppBarStyle => Chrome.CaptionButtonsWidth > 0
        ? FormattableString.Invariant($"padding-right: {Math.Ceiling(Chrome.CaptionButtonsWidth)}px")
        : null;

    private IJSObjectReference? _layoutModule;
    private string _path = "";

    /// <summary>A new page starts at the top of the content scroll container (design D3).</summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var path = new Uri(e.Location).AbsolutePath;
        if (path == _path) return;
        _path = path;
        if (_layoutModule is { } module) _ = InvokeAsync(async () =>
        {
            try { await module.InvokeVoidAsync("scrollContentToTop"); }
            catch (JSDisconnectedException) { }
        });
    }

    private void OnChromeChanged() => InvokeAsync(StateHasChanged);

    /// <summary>The app bar's interactive elements, reported by windowChrome.js, take clicks instead of dragging.</summary>
    [JSInvokable]
    public void SetInteractiveRegions(AssetManager.Core.Platform.ChromeRect[] regions) => Chrome.SetInteractiveRegions(regions);

    private DotNetObjectReference<MainLayout>? _selfRef;

    /// <summary>Dropped files go to the import page, which takes them from the broker.</summary>
    private void OnFilesDropped() => InvokeAsync(() =>
    {
        if (!Nav.Uri.Contains("/import", StringComparison.OrdinalIgnoreCase)) Nav.NavigateTo("import");
    });

    [JSInvokable]
    public void DropUnsupported() =>
        Snackbar.Add("Drag and drop of files needs the desktop app; use the Add buttons instead.", Severity.Info);

    private Task OnSystemDarkChanged(bool dark)
    {
        _systemDark = dark;
        ApplyTheme();
        return Task.CompletedTask;
    }

    private void OnSettingsChanged(AppSettings _) => InvokeAsync(ApplyTheme);

    private void ApplyTheme()
    {
        _isDark = Settings.Current.Theme switch
        {
            ThemeMode.Dark => true,
            ThemeMode.Light => false,
            _ => _systemDark,
        };
        // Caption buttons follow the theme's app bar colours (spec "System caption buttons").
        var text = (_isDark ? _theme.PaletteDark : _theme.PaletteLight).AppbarText;
        Chrome.SetCaptionColors(text.ToString(MudBlazor.Utilities.MudColorOutputFormats.HexA),
            text.SetAlpha(0.12).ToString(MudBlazor.Utilities.MudColorOutputFormats.HexA));
        StateHasChanged();
    }

    public void Dispose()
    {
        Settings.Changed -= OnSettingsChanged;
        Drops.Dropped -= OnFilesDropped;
        Chrome.Changed -= OnChromeChanged;
        Nav.LocationChanged -= OnLocationChanged;
        _selfRef?.Dispose();
    }
}
