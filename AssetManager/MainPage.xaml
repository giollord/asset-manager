<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AssetManager"
             xmlns:shared="clr-namespace:AssetManager.Shared;assembly=AssetManager.Shared"
             x:Class="AssetManager.MainPage"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <local:AppBlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <local:AppBlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type shared:Routes}" />
        </local:AppBlazorWebView.RootComponents>
    </local:AppBlazorWebView>

</ContentPage>
