<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>

    <OutputType>Exe</OutputType>
    <RootNamespace>AssetManager</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Disable MAUI CSS handling so Blazor can handle it -->
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <Nullable>enable</Nullable>

    <!-- Enable XAML source generation for faster build times and improved performance.
         This generates C# code from XAML at compile time instead of runtime inflation.
         To disable, remove this line.
         For individual files, you can override by setting Inflator metadata:
           <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
           <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <!-- Display name -->
    <ApplicationTitle>Asset Manager</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>io.github.giollord.assetmanager</ApplicationId>

    <!-- File metadata shown in the exe's Properties -> Details (spec "App identity") -->
    <Product>Asset Manager</Product>
    <AssemblyTitle>Asset Manager</AssemblyTitle>
    <Company>Daniil Barkov</Company>
    <Authors>Daniil Barkov</Authors>
    <Copyright>Copyright (c) 2026 Daniil Barkov</Copyright>
    <Description>Offline catalog for game assets</Description>

    <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <!-- The logo itself with no background layer, so the icon is transparent around the drawing -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1E2A33" BaseSize="128,128" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Portable publish (spec "Portable Windows package"): a self-contained x64 folder that runs without installing .NET
    or the Windows App SDK, with a "portable" marker so the app keeps its data in "data" next to the exe.
      dotnet publish AssetManager/AssetManager.csproj -c Release -f net10.0-windows10.0.19041.0 -p:Portable=true
        -o publish/AssetManager
    The version comes from the git tags (MinVer, see Directory.Build.props).
  -->
  <PropertyGroup Condition="'$(Portable)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <!-- Compact package (spec "Compact package layout", design D1/D3): one exe instead of ~800 files. Native libraries
         are extracted once to %TEMP%\.net on first start; uncompressed so starting does not unpack the bundle. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!--
    Left out of the portable package (design D3): the tile and logo images MAUI generates for an MSIX package (only
    appicon.ico is used unpackaged), and Windows ML's ONNX Runtime/DirectML, which the app never calls (~40 MB).
  -->
  <Target Name="TrimPortablePackage" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(Portable)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="($([System.String]::Copy('%(ResolvedFileToPublish.Filename)').StartsWith('appicon')) And '%(ResolvedFileToPublish.Extension)' == '.png') Or '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'onnxruntime.dll' Or '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'DirectML.dll'" />
    </ItemGroup>
  </Target>

  <!--
    After publish (spec "Compact package layout"):
    - the "portable" marker is copied here, because the MSIX tooling that single-file publishing needs drops this extension-less item;
    - the web content becomes one wwwroot.zip, served by AppBlazorWebView (design D2). Static web assets are copied by
      their own publish step, outside the single-file bundle, so they are zipped afterwards. The pre-compressed
      .br/.gz copies are left out: the web view reads local content, compression gains nothing.
  -->
  <Target Name="FinishPortablePackage" AfterTargets="Publish" Condition="'$(Portable)' == 'true'">
    <Copy SourceFiles="Packaging\portable" DestinationFolder="$(PublishDir)" />
    <ItemGroup>
      <_PrecompressedWebContent Include="$(PublishDir)wwwroot\**\*.br;$(PublishDir)wwwroot\**\*.gz" />
    </ItemGroup>
    <Delete Files="@(_PrecompressedWebContent)" />
    <ZipDirectory SourceDirectory="$(PublishDir)wwwroot" DestinationFile="$(PublishDir)wwwroot.zip" Overwrite="true" />
    <RemoveDir Directories="$(PublishDir)wwwroot" />
    <!-- The bundle carries its own copy (it is extracted next to the app). -->
    <Delete Files="$(PublishDir)$(AssemblyName).staticwebassets.endpoints.json" />
  </Target>

  <!-- The app's own MIT license, shipped next to the exe (spec "Portable Windows package"). -->
  <ItemGroup>
    <None Include="..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AssetManager.Shared\AssetManager.Shared.csproj" />
  </ItemGroup>

</Project>
